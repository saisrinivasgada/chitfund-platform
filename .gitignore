# Java build output
*/target/
*.jar
*.war
*.class

# Maven wrapper
.mvn/wrapper/maven-wrapper.jar

# Node
node_modules/
chitfund-frontend/node_modules/
chitfund-frontend/dist/

# Secrets — NEVER commit these
*.pem
.env
.env.prod
.env.local
.env.*

# AWS resource IDs (contain account numbers)
aws-resources.txt

# IDE / OS
.idea/
*.iml
.DS_Store
*.swp

# Logs
logs/
*.log

# Expo device history and local development-server state
chitwise-mobile/.expo/

# Private project documents live outside this repository in Projects/chitwise.
# Prevent the removed plans/guides from being accidentally added again.
/ARCHITECTURE.md
/docs/
/ops/runbooks/
/tests/DESIGN-*.md
/tests/PLAN-*.md
/tests/e2e/PRODUCTION_DUPLICATE_SETTLEMENT_CHECK.md
/chitfund-frontend/CLAUDE.md
/chitfund-frontend/README.md
/chitfund-user-service/src/main/resources/db/migration/README.md
