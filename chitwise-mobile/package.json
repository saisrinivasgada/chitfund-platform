{
  "name": "chitwise-mobile",
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:hub": "EXPO_PUBLIC_APP_VARIANT=hub expo start",
    "android": "expo run:android",
    "android:hub": "EXPO_PUBLIC_APP_VARIANT=hub expo run:android",
    "ios": "expo run:ios",
    "ios:hub": "EXPO_PUBLIC_APP_VARIANT=hub expo run:ios",
    "web": "expo start --web",
    "audit:ci": "node scripts/audit-dependencies.mjs",
    "audit:test": "node --test scripts/audit-dependencies.test.mjs",
    "offline:policy:test": "node --experimental-strip-types --test tests/offline/simulator-link.test.mjs components/tabBarMetrics.test.mjs features/chits/drawRequest.test.mjs offline/accessPolicy.test.mjs store/serializeActions.test.mjs store/savedAccounts.test.mjs store/reviewNavigationStore.test.mjs && node --experimental-vm-modules --test offline/paymentQueue.test.mjs offline/signOut.test.mjs offline/signOutDatabase.test.mjs offline/staffQueue.test.mjs offline/staffReviews.test.mjs offline/useOnlineMutation.test.mjs store/toolkitStore.test.mjs",
    "type-check": "tsc --noEmit",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-persist-client": "^5.101.2",
    "axios": "^1.20.0",
    "expo": "~54.0.37",
    "expo-background-task": "~1.0.10",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.20",
    "image-size": "file:vendor/image-size-compat",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "^0.5.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "expo-doctor": "1.20.4",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "image-size": "$image-size",
    "postcss": "8.5.28",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2"
  },
  "private": true
}
